{
  "name": "kamargin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:game-data": "node scripts/generate-game-data.mjs",
    "generate:ocr-assets": "node scripts/vendor-ocr.mjs",
    "verify:ocr-assets": "node scripts/vendor-ocr.mjs --check",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "capture:ocr-fixtures": "node src/features/screenshot-import/utils/tests/capture-fixtures.mjs",
    "build": "tsc --noEmit && vite build",
    "lint": "biome lint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "biome format --write .",
    "check": "biome check --write --unsafe .",
    "ci": "npm run verify:ocr-assets && biome ci . && knip --config knip.jsonc",
    "knip": "knip --config knip.jsonc"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.5",
    "react-router": "^8.3.1",
    "shadcn": "^4.21.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "knip": "^6.35.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
