{
  // Local copy: cannot drift from the installed version.
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // public/ is standalone SVG assets, not components: a11y rules misfire.
    "includes": [
      "**",
      "!dist",
      "!.agents/skills",
      "!public",
      // Generated bundle: formatting it would multiply its size.
      "!src/assets/game-data"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "css": {
    // Tailwind v4 configures in CSS: @theme, @custom-variant, @apply.
    "parser": { "tailwindDirectives": true }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "domains": { "react": "recommended" },
    "rules": {
      "preset": "recommended",
      "nursery": {
        // Unsafe fix, so only `npm run check` (--unsafe) applies it.
        "useSortedClasses": {
          "level": "warn",
          "options": { "functions": ["cn", "clsx"] }
        }
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },

  "overrides": [
    {
      // Reusable wrapper: the caller supplies htmlFor, so this file cannot.
      "includes": ["src/components/ui/label.tsx"],
      "linter": { "rules": { "a11y": { "noLabelWithoutControl": "off" } } }
    },
    {
      // Addons decorate a focusable control; a fieldset would announce a form.
      "includes": ["src/components/ui/input-group.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    },

    // Unidirectional imports; matches strings, not paths. Why: AGENTS.md.
    {
      "includes": ["src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**"],
                    "message": "A feature must not import from the app layer. Compose features in src/app instead."
                  },
                  // No self-exception: that is what avoids a config entry per feature.
                  {
                    "group": ["@/features/**"],
                    "message": "No @/features/* imports inside a feature: another feature is off limits (compose them in src/app), and your own feature is reached with a relative path."
                  },
                  {
                    "group": ["../../**"],
                    "message": "Relative imports must not climb out of the module. Use the @/ alias, which the layer rules can see."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Shared layer: imported by everything, imports nothing above it.
      "includes": [
        "src/components/**",
        "src/config/**",
        "src/hooks/**",
        "src/lib/**",
        "src/stores/**",
        "src/types/**",
        "src/utils/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/features/**"],
                    "message": "Shared code must not import from features or the app layer. Dependencies point one way: shared -> features -> app."
                  },
                  {
                    "group": ["../../**"],
                    "message": "Relative imports must not climb out of the module. Use the @/ alias, which the layer rules can see."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // A test sits one folder below its subject: the climb is how it reaches it.
      "includes": ["src/**/tests/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/features/**"],
                    "message": "A test crosses no layer its subject cannot cross. Reach the subject relatively."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
