{
  // Local copy, not the hosted URL: works offline and cannot drift from the
  // installed Biome version.
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // public/ holds standalone SVG assets, not components: a11y rules do not apply.
    "includes": ["**", "!dist", "!.agents/skills", "!public"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "domains": { "react": "recommended" },
    "rules": {
      "preset": "recommended",
      "nursery": {
        // Tailwind class sorting. Still nursery and its fix is unsafe, so only
        // `biome check --write --unsafe` (npm run check) applies it.
        "useSortedClasses": {
          "level": "warn",
          "options": { "functions": ["cn", "clsx"] }
        }
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },

  // Unidirectional codebase: shared -> features -> app. See AGENTS.md.
  // noRestrictedImports matches the import STRING, not a resolved path, so every
  // rule below reasons about `@/…` specifiers — hence the `../../**` guard, which
  // stops a relative climb from escaping the layer check.
  "overrides": [
    {
      "includes": ["src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**"],
                    "message": "A feature must not import from the app layer. Compose features in src/app instead."
                  },
                  // Deliberately no self-exception: banning @/features/** outright
                  // makes cross-feature isolation enforceable without a config
                  // entry per feature. A feature reaches its own files relatively.
                  {
                    "group": ["@/features/**"],
                    "message": "No @/features/* imports inside a feature: another feature is off limits (compose them in src/app), and your own feature is reached with a relative path."
                  },
                  {
                    "group": ["../../**"],
                    "message": "Relative imports must not climb out of the module. Use the @/ alias, which the layer rules can see."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // The shared layer: importable by everything, importing nothing above it.
      "includes": [
        "src/components/**",
        "src/config/**",
        "src/hooks/**",
        "src/lib/**",
        "src/stores/**",
        "src/types/**",
        "src/utils/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/features/**"],
                    "message": "Shared code must not import from features or the app layer. Dependencies point one way: shared -> features -> app."
                  },
                  {
                    "group": ["../../**"],
                    "message": "Relative imports must not climb out of the module. Use the @/ alias, which the layer rules can see."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
